{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "eva-games-staging",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eva-games-staging",
			"database_id": "091b653c-9849-41f3-8477-508d14b82105",
			"migrations_dir": "migrations"
		}
	],
	// R2 media bucket (MEDIA) is added in Phase 3 once R2 is enabled on the account:
	// "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "eva-games-media-staging" }],
	"vars": {
		"APP_ENV": "staging",
		"VAPID_SUBJECT": "https://evagames.org",
		"VAPID_PUBLIC_KEY": "BLlHwop1VSvblM-pJHoqoTj5OsU2-MhKo5E8hI7hVEQzKpE4OIWcYngUJlni5znVp970o8VU6DWB71YI4WgwEE4",
		"TURNSTILE_SITE_KEY": ""
	}
	// Secrets (set with `npx wrangler secret put <NAME>`):
	//   SETUP_TOKEN        one-time token for creating Eva's owner account at /setup
	//   VAPID_PRIVATE_KEY  web push private key (base64url, generated by `npm run vapid`)
	//   TURNSTILE_SECRET   Cloudflare Turnstile secret (optional; captcha off when unset)
}
